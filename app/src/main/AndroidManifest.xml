<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneTracker_Kotlin">

        <activity
            android:name=".presenter.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PhoneTracker_Kotlin.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".presenter.auth.LoginActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".presenter.auth.CreateAccountActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".presenter.auth.PasswordActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".presenter.auth.OtpActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustNothing" />
        <activity android:name=".presenter.home.HomeActivity" android:screenOrientation="portrait" />
        <activity android:name=".presenter.profile.ProfileActivity" android:screenOrientation="portrait" />
        <activity android:name=".presenter.about.AboutActivity" android:screenOrientation="portrait" />
        <activity android:name=".presenter.cards.CardPaymentActivity" android:screenOrientation="portrait" />
        <activity android:name=".presenter.cards.AddCardActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".presenter.bill.BillListActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".presenter.bill.NewBillerActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".presenter.bill.PaymentSuccessActivity" android:screenOrientation="portrait" />
        <activity android:name=".presenter.transfer.TransferListActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".presenter.transfer.TransferAmountActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustNothing" />
        <activity android:name=".presenter.transfer.TransferConfirmActivity" android:screenOrientation="portrait" />
        <activity android:name=".presenter.transfer.TransferFailureActivity" android:screenOrientation="portrait" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ad_app_id}" />
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="true" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="true" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="true" />
        <meta-data
            android:name="applovin.sdk.key"
            android:value="@string/applovin_sdk_key" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED"
            android:value="false" />
    </application>
</manifest>
