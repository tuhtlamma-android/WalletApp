    </item>
    <item android:width="190dp" android:height="190dp" android:gravity="bottom|end" android:right="-4dp" android:bottom="-94dp">
        <shape android:shape="oval">
            <solid android:color="#5732BF" />
        </shape>
    </item>
    <item android:width="170dp" android:height="170dp" android:gravity="bottom|end" android:right="-54dp" android:bottom="-45dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
