<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/wallet_purple_soft" />
            <stroke android:width="2dp" android:color="@color/wallet_purple" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wallet_surface_alt" />
            <stroke android:width="1dp" android:color="@color/wallet_alice_blue" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
