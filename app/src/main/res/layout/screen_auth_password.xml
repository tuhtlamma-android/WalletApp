<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="384dp"
        android:background="#F5F1FF">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="‹  Back"
            android:textColor="@color/wallet_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="54dp"
            android:src="@drawable/img_text_screen"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="190dp"
            android:layout_height="194dp"
            android:layout_gravity="center"
            android:contentDescription="@string/password"
            android:padding="24dp"
            android:src="@drawable/ic_wallet_security" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextAppearance.Wallet.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_password" />

        <TextView
            style="@style/TextAppearance.Wallet.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/password"
            android:textColor="@color/wallet_black" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_wallet_outline"
            android:hint="Enter your password"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="@color/wallet_black"
            android:textColorHint="@color/wallet_slate"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/forgotButton"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="end|center_vertical"
            android:text="@string/forgot_password"
            android:textColor="@color/wallet_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton"
            style="@style/Widget.Wallet.PrimaryButton"
            android:layout_width="match_parent"
            android:text="@string/login" />


    </LinearLayout>
</LinearLayout>
