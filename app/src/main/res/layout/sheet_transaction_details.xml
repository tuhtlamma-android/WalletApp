<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_wallet_circle_blue" android:gravity="center" android:text="W" android:textColor="@color/wallet_blue" android:textStyle="bold" />
        <TextView style="@style/TextAppearance.Wallet.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Walmart\nRetailer corporation" android:textSize="16sp" />
        <TextView android:id="@+id/doneButton" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:text="Done" android:textColor="@color/wallet_blue" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="24dp" android:background="@drawable/bg_wallet_error_soft" android:gravity="center" android:text="-$35.23" android:textColor="@color/wallet_error" android:textSize="22sp" android:textStyle="bold" />
    <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:background="@drawable/bg_wallet_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Today\nDecember 29, 2022 – 12:32" android:textStyle="bold" />
    <TextView android:id="@+id/copyButton" style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:background="@drawable/bg_wallet_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Transaction no.\n23010412432431                                             ▣" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:text="@string/report_problem" android:textColor="@color/wallet_error" android:textStyle="bold" />
</LinearLayout>
