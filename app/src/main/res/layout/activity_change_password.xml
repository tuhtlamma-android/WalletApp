<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <FrameLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/backButton"
                style="@style/Widget.Wallet.BackButton"
                android:layout_gravity="center_vertical|start" />

            <ImageView
                android:layout_width="89dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/img_text_screen" />

        </FrameLayout>

        <Space
            android:id="@+id/flexibleSpace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/contentScroll"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flexibleSpace">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/TextAppearance.Wallet.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/change_password"
                    android:textSize="21sp" />

                <TextView
                    style="@style/TextAppearance.Wallet.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/change_password_description" />

                <TextView
                    style="@style/TextAppearance.Wallet.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/current_password"
                    android:textColor="@color/wallet_black" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_wallet_outline">

                    <EditText
                        android:id="@+id/currentPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="password"
                        android:background="@null"
                        android:hint="@string/current_password_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="48dp"
                        android:textColor="@color/wallet_black"
                        android:textColorHint="@color/wallet_input_hint"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/currentPasswordToggle"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:contentDescription="@string/toggle_password"
                        android:padding="11dp"
                        android:src="@drawable/ic_wallet_eye_off" />

                </FrameLayout>

                <TextView
                    style="@style/TextAppearance.Wallet.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/new_password"
                    android:textColor="@color/wallet_black" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_wallet_outline">

                    <EditText
                        android:id="@+id/newPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="newPassword"
                        android:background="@null"
                        android:hint="@string/new_password_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="48dp"
                        android:textColor="@color/wallet_black"
                        android:textColorHint="@color/wallet_input_hint"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/newPasswordToggle"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:contentDescription="@string/toggle_password"
                        android:padding="11dp"
                        android:src="@drawable/ic_wallet_eye_off" />

                </FrameLayout>

                <TextView
                    style="@style/TextAppearance.Wallet.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/password_requirement" />

                <TextView
                    style="@style/TextAppearance.Wallet.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/confirm_new_password"
                    android:textColor="@color/wallet_black" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_wallet_outline">

                    <EditText
                        android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="newPassword"
                        android:background="@null"
                        android:hint="@string/confirm_new_password_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="48dp"
                        android:textColor="@color/wallet_black"
                        android:textColorHint="@color/wallet_input_hint"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/confirmPasswordToggle"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:contentDescription="@string/toggle_password"
                        android:padding="11dp"
                        android:src="@drawable/ic_wallet_eye_off" />

                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updatePasswordButton"
                    style="@style/Widget.Wallet.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="20dp"
                    android:text="@string/update_password" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
