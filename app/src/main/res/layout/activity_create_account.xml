<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <FrameLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/backButton"
                style="@style/Widget.Wallet.BackButton"
                android:layout_gravity="center_vertical|start" />

            <ImageView
                android:layout_width="89dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/img_text_screen" />

        </FrameLayout>


        <!-- ========================= -->
        <!-- FLEXIBLE SPACE -->
        <!-- Tự ăn khoảng trống -->
        <!-- ========================= -->

        <Space
            android:id="@+id/flexibleSpace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toTopOf="@id/contentScroll"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ========================= -->
        <!-- BOTTOM CONTENT -->
        <!-- ========================= -->

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/flexibleSpace"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/contentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">


                <!-- TITLE -->

                <TextView
                    style="@style/TextAppearance.Wallet.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/create_account"
                    android:textSize="21sp" />


                <!-- NAME LABEL -->

                <TextView
                    style="@style/TextAppearance.Wallet.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/name"
                    android:textColor="@color/wallet_black" />


                <!-- NAME INPUT -->

                <EditText
                    android:id="@+id/nameInput"
                    style="@style/Widget.Wallet.Input"
                    android:hint="@string/name_hint"
                    android:inputType="textCapWords"
                    android:maxLines="1" />


                <!-- EMAIL LABEL -->

                <TextView
                    style="@style/TextAppearance.Wallet.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/email"
                    android:textColor="@color/wallet_black" />


                <!-- EMAIL INPUT -->

                <EditText
                    android:id="@+id/emailInput"
                    style="@style/Widget.Wallet.Input"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />


                <!-- PASSWORD LABEL -->

                <TextView
                    style="@style/TextAppearance.Wallet.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/password"
                    android:textColor="@color/wallet_black" />


                <!-- PASSWORD INPUT -->

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_wallet_outline">

                    <EditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/password_hint"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="48dp"
                        android:textColor="@color/wallet_black"
                        android:textColorHint="@color/wallet_input_hint"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/passwordToggle"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:contentDescription="@string/toggle_password"
                        android:padding="11dp"
                        android:src="@drawable/ic_wallet_eye_off" />

                </FrameLayout>


                <!-- TERMS -->

                <CheckBox
                    android:id="@+id/termsCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:buttonTint="@color/wallet_purple"
                    android:text="@string/terms_copy"
                    android:textColor="@color/wallet_black_coral"
                    android:textSize="9sp" />


                <!-- REGISTER BUTTON -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registerButton"
                    style="@style/Widget.Wallet.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:text="@string/create_new_account" />


                <!-- OR CONTINUE USING -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/wallet_alice_blue" />

                    <TextView
                        style="@style/TextAppearance.Wallet.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:text="@string/or_continue_using" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/wallet_alice_blue" />

                </LinearLayout>


                <!-- SOCIAL BUTTONS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Widget.Wallet.SocialButton"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_facebook_logo" />

                    <ImageView
                        style="@style/Widget.Wallet.SocialButton"
                        android:layout_marginHorizontal="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_google_logo" />

                    <ImageView
                        style="@style/Widget.Wallet.SocialButton"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_apple_logo" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>