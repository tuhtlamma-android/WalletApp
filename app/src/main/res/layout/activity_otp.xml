<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
            <TextView android:id="@+id/backButton" style="@style/Widget.Wallet.BackButton" android:layout_gravity="start|center_vertical" />
            <ImageView android:layout_width="89dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="@string/app_name" android:src="@drawable/img_text_screen" />
        </FrameLayout>
        <TextView style="@style/TextAppearance.Wallet.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/sms_sent" android:textColor="@color/wallet_black" />
        <TextView style="@style/TextAppearance.Wallet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="@string/enter_six_digit_code" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:gravity="center" android:orientation="horizontal">
            <EditText
                android:id="@+id/otpInput"
                android:layout_width="198dp"
                android:layout_height="64dp"
                android:backgroundTint="@color/wallet_purple"
                android:gravity="center"
                android:hint="XXX-XXX"
                android:inputType="text"
                android:maxLength="7"
                android:textColor="@color/wallet_black"
                android:textColorHint="@color/wallet_input_hint"
                android:textSize="36sp" />
            <ImageView android:id="@+id/validIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null" android:src="@drawable/ic_wallet_otp_valid"
                android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/resendButton" style="@style/TextAppearance.Wallet.Link" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="@string/resend_code" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="267dp"
            android:background="@color/wallet_surface_alt"
            android:columnCount="3"
            android:rowCount="4">
            <TextView
                android:id="@+id/key1"
                style="@style/Widget.Wallet.Key"
                android:text="1" />
            <TextView
                android:id="@+id/key2"
                style="@style/Widget.Wallet.Key"
                android:text="2" />
            <TextView
                android:id="@+id/key3"
                style="@style/Widget.Wallet.Key"
                android:text="3" />
            <TextView android:id="@+id/key4" style="@style/Widget.Wallet.Key" android:text="4" />
            <TextView android:id="@+id/key5" style="@style/Widget.Wallet.Key" android:text="5" />
            <TextView android:id="@+id/key6" style="@style/Widget.Wallet.Key" android:text="6" />
            <TextView android:id="@+id/key7" style="@style/Widget.Wallet.Key" android:text="7" />
            <TextView android:id="@+id/key8" style="@style/Widget.Wallet.Key" android:text="8" />
            <TextView android:id="@+id/key9" style="@style/Widget.Wallet.Key" android:text="9" />
            <Space style="@style/Widget.Wallet.Key" />
            <TextView android:id="@+id/key0" style="@style/Widget.Wallet.Key" android:text="0" />
            <ImageView android:id="@+id/deleteKey" style="@style/Widget.Wallet.KeyImage" android:contentDescription="@string/delete" android:src="@drawable/ic_wallet_keypad_delete" />
        </GridLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="69dp" android:background="@color/wallet_surface_alt" android:paddingHorizontal="16dp" android:paddingBottom="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/doneButton" style="@style/Widget.Wallet.PrimaryButton" android:layout_width="match_parent" android:layout_gravity="bottom" android:text="@string/done" />
        </FrameLayout>
    </LinearLayout>
</layout>
