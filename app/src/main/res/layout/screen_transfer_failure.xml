<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F8"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <ImageView android:layout_width="126dp" android:layout_height="126dp" android:background="@drawable/bg_wallet_error_circle" android:contentDescription="Transfer failed" android:padding="34dp" android:src="@drawable/ic_wallet_close" />
    <TextView style="@style/TextAppearance.Wallet.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Transfer Failed :(" android:textSize="16sp" />
    <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Your transfer has been declined\ndue to a technical issue" />
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <com.google.android.material.button.MaterialButton android:id="@+id/backToWalletButton" style="@style/Widget.Wallet.PrimaryButton" android:layout_width="match_parent" android:text="@string/back_to_wallet" />
</LinearLayout>
