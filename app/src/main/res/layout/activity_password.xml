<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wallet_auth_background">


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@color/wallet_auth_background"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- BACK -->

            <TextView
                android:id="@+id/backButton"
                style="@style/Widget.Wallet.BackButton"
                android:layout_gravity="center_vertical|start" />

            <!-- LOGO -->

            <ImageView
                android:layout_width="89dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/img_text_screen" />

        </androidx.appcompat.widget.Toolbar>


        <!-- ========================= -->
        <!-- MIDDLE / ILLUSTRATION -->
        <!-- Cao 292dp để header + illustration đúng vùng hero 340dp của Figma -->
        <!-- ========================= -->

        <FrameLayout
            android:id="@+id/illustrationContainer"
            android:layout_width="0dp"
            android:layout_height="292dp"
            android:background="@color/wallet_auth_background"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/securityIllustration"
                android:layout_width="156dp"
                android:layout_height="194dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wallet_security" />

        </FrameLayout>


        <!-- ========================= -->
        <!-- BOTTOM CONTENT -->
        <!-- ========================= -->

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/illustrationContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/contentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">


            <!-- TITLE -->

            <TextView
                style="@style/TextAppearance.Wallet.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/enter_password"
                android:textSize="21sp" />


            <!-- PASSWORD LABEL -->

            <TextView
                style="@style/TextAppearance.Wallet.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/password"
                android:textColor="@color/wallet_black" />


            <!-- PASSWORD INPUT -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_wallet_outline">

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/password_hint"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="48dp"
                    android:textColor="@color/wallet_black"
                    android:textColorHint="@color/wallet_input_hint"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/passwordToggle"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:contentDescription="@string/toggle_password"
                    android:padding="11dp"
                    android:src="@drawable/ic_wallet_eye_off" />

            </FrameLayout>


            <!-- FORGOT PASSWORD -->

            <TextView
                android:id="@+id/forgotButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="end|center_vertical"
                android:text="@string/forgot_password"
                android:textColor="@color/wallet_blue"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- Giữ nút Login ở đáy như frame Figma, phần nội dung trên không bị kéo giãn -->

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />


            <!-- LOGIN -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginButton"
                style="@style/Widget.Wallet.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:text="@string/login" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
