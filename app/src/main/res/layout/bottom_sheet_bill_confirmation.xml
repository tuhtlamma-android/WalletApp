        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="24dp" android:background="@drawable/bg_wallet_error_soft" android:gravity="center" android:text="Due: $132.32" android:textColor="@color/wallet_error" android:textSize="20sp" android:textStyle="bold" />
        <TextView style="@style/Widget.Wallet.DetailBox" android:text="Due date\nDecember 29, 2022 – 12:32" />
        <TextView style="@style/Widget.Wallet.DetailBox" android:text="Registration no.\n23010412432431" />
        <com.google.android.material.button.MaterialButton android:id="@+id/securePaymentButton" style="@style/Widget.Wallet.PrimaryButton" android:layout_width="match_parent" android:layout_marginTop="24dp" android:backgroundTint="@color/wallet_mango" android:text="Secure payment" android:textColor="@color/wallet_purple_dark" app:icon="@drawable/ic_wallet_secure" app:iconGravity="textStart" app:iconSize="18dp" app:iconTint="@null" />
    </LinearLayout>
</layout>
