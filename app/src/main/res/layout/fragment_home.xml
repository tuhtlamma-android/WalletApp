<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="274dp"
                android:background="@color/wallet_purple_dark"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/profileAvatarButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/profile_settings"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_avatar_abdullah" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/sora_family"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/hello_abdullah"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/profileButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/profile_settings"
                        android:padding="8dp"
                        android:src="@drawable/ic_wallet_settings" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="178dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_wallet_balance"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="24dp"
                    android:paddingBottom="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_family"
                        android:includeFontPadding="false"
                        android:text="@string/main_balance"
                        android:textColor="@color/wallet_balance_label"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/balanceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/sora_family"
                        android:includeFontPadding="false"
                        android:visibility="invisible"
                        android:textColor="@color/white"
                        android:textSize="36sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/topUpButton"
                            style="@style/Widget.Wallet.BalanceAction"
                            android:orientation="vertical">
                            <ImageView style="@style/Widget.Wallet.BalanceActionIcon"
                                android:src="@drawable/ic_balance_top_up" />
                            <TextView style="@style/Widget.Wallet.BalanceActionLabel"
                                android:text="Top up" />
                        </LinearLayout>
                        <View style="@style/Widget.Wallet.BalanceDivider" />
                        <LinearLayout style="@style/Widget.Wallet.BalanceAction"
                            android:orientation="vertical">
                            <ImageView style="@style/Widget.Wallet.BalanceActionIcon"
                                android:src="@drawable/ic_balance_withdraw" />
                            <TextView style="@style/Widget.Wallet.BalanceActionLabel"
                                android:text="Withdraw" />
                        </LinearLayout>
                        <View style="@style/Widget.Wallet.BalanceDivider" />
                        <LinearLayout android:id="@+id/transferButton" style="@style/Widget.Wallet.BalanceAction"
                            android:orientation="vertical">
                            <ImageView style="@style/Widget.Wallet.BalanceActionIcon"
                                android:src="@drawable/ic_balance_transfer" />
                            <TextView style="@style/Widget.Wallet.BalanceActionLabel"
                                android:text="Transfer" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="24dp"
                android:paddingEnd="16dp">
                <TextView style="@style/TextAppearance.Wallet.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recent_transfers" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/addContactButton" style="@style/Widget.Wallet.AvatarColumn">
                        <ImageView style="@style/Widget.Wallet.AvatarImage"
                            android:src="@drawable/ic_add_contact"
                            />
                        <TextView style="@style/Widget.Wallet.AvatarName"
                            android:text="Add" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recentTransferList"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:paddingEnd="16dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/TextAppearance.Wallet.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/latest_transactions" />
                    <TextView android:id="@+id/viewAllButton" style="@style/TextAppearance.Wallet.Body" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="@string/view_all" android:textColor="@color/wallet_slate" />
                </LinearLayout>
                <TextView
                    android:id="@+id/latestEmptyState"
                    style="@style/TextAppearance.Wallet.Body"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:gravity="center"
                    android:text="@string/no_transactions_yet"
                    android:textColor="@color/wallet_slate" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/latestTransactionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
