<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:id="@+id/backButton" android:layout_width="wrap_content" android:layout_height="52dp" android:gravity="center_vertical" android:text="‹  Back" android:textColor="@color/wallet_blue" android:textSize="12sp" android:textStyle="bold" />
    <TextView style="@style/TextAppearance.Wallet.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="@string/transfer_to" />
    <TextView android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="24dp" android:gravity="center" android:text="AA    Ali Ahmed\n        +1-300-555-0161" android:textColor="@color/wallet_black" android:textSize="14sp" android:textStyle="bold" />
    <TextView style="@style/TextAppearance.Wallet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:gravity="center" android:text="Enter Amount" />
    <TextView android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center" android:text="$1,252.00" android:textColor="@color/wallet_black" android:textSize="36sp" />
