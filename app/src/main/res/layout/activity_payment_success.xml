<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageView android:layout_width="170dp" android:layout_height="132dp" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:contentDescription="@string/payment_done" android:scaleType="fitCenter" android:src="@drawable/img_payment_success_art" />
        <TextView style="@style/TextAppearance.Wallet.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/payment_done" android:textSize="17sp" />
        <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:lineSpacingExtra="4dp" android:text="Bill payment has been done\nsuccessfully" android:textColor="@color/wallet_black_coral" />
        <TextView style="@style/TextAppearance.Wallet.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="78dp" android:text="Payment details" />
        <TextView style="@style/Widget.Wallet.DetailBox" android:layout_marginTop="16dp" android:text="Biller\nElectricity company inc." />
        <TextView style="@style/Widget.Wallet.DetailBox" android:text="Amount\n$132.32" />
        <LinearLayout android:id="@+id/copyButton" style="@style/Widget.Wallet.DetailBoxRow" android:orientation="horizontal">
            <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:lineSpacingExtra="3dp" android:text="Transaction no.\n23010412432431" android:textColor="@color/wallet_black_coral" android:textStyle="bold" />
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" android:src="@drawable/ic_wallet_copy" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_wallet_report" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/report_problem" android:textColor="@color/wallet_error" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/backToWalletButton" style="@style/Widget.Wallet.PrimaryButton" android:layout_width="match_parent" android:layout_marginBottom="16dp" android:text="@string/back_to_wallet" />
    </LinearLayout>
</layout>
