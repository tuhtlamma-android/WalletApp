<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                <TextView android:id="@+id/backButton"
                    style="@style/Widget.Wallet.BackButton"
                    android:layout_gravity="start|center_vertical"
                    android:paddingStart="12dp" />
                <TextView style="@style/TextAppearance.Wallet.DialogTitle" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:text="@string/profile_settings" />
            </FrameLayout>
            <ImageView android:layout_width="110dp" android:layout_height="112dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:contentDescription="@null" android:src="@drawable/img_profile_verified" />
            <TextView android:id="@+id/profileNameText" style="@style/TextAppearance.Wallet.ItemTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/profile_name_placeholder" />
            <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="@string/local_account" android:textColor="@color/wallet_slate" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="38dp" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
                <LinearLayout style="@style/Widget.Wallet.ProfileRow" android:orientation="horizontal">
                    <ImageView style="@style/Widget.Wallet.MenuIcon" android:src="@drawable/ic_profile_name" />
                    <LinearLayout style="@style/Widget.Wallet.ProfileContent" android:orientation="vertical">
                        <TextView style="@style/Widget.Wallet.ProfileLabel" android:text="Full name" />
                        <TextView android:id="@+id/fullNameText" style="@style/Widget.Wallet.ProfileValue" android:text="@string/profile_name_placeholder" />
                    </LinearLayout>
                    <TextView style="@style/Widget.Wallet.ProfileEdit" android:text="Edit" />
                </LinearLayout>
                <View style="@style/Widget.Wallet.Divider" />
                <LinearLayout style="@style/Widget.Wallet.ProfileRow" android:orientation="horizontal">
                    <ImageView style="@style/Widget.Wallet.MenuIcon" android:src="@drawable/ic_profile_mobile" />
                    <LinearLayout style="@style/Widget.Wallet.ProfileContent" android:orientation="vertical">
                        <TextView style="@style/Widget.Wallet.ProfileLabel" android:text="Mobile" />
                        <TextView android:id="@+id/mobileText" style="@style/Widget.Wallet.ProfileValue" android:text="@string/not_provided" />
                    </LinearLayout>
                    <TextView style="@style/Widget.Wallet.ProfileEdit" android:text="Edit" />
                </LinearLayout>
                <View style="@style/Widget.Wallet.Divider" />
                <LinearLayout style="@style/Widget.Wallet.ProfileRow" android:orientation="horizontal">
                    <ImageView style="@style/Widget.Wallet.MenuIcon" android:src="@drawable/ic_profile_email" />
                    <LinearLayout style="@style/Widget.Wallet.ProfileContent" android:orientation="vertical">
                        <TextView style="@style/Widget.Wallet.ProfileLabel" android:text="Email" />
                        <TextView android:id="@+id/emailText" style="@style/Widget.Wallet.ProfileValue" android:text="@string/not_provided" />
                    </LinearLayout>
                    <TextView style="@style/Widget.Wallet.ProfileEdit" android:text="Edit" />
                </LinearLayout>
                <View style="@style/Widget.Wallet.Divider" />
                <LinearLayout style="@style/Widget.Wallet.ProfileRow" android:orientation="horizontal">
                    <ImageView style="@style/Widget.Wallet.MenuIcon" android:src="@drawable/ic_profile_password" />
                    <TextView style="@style/Widget.Wallet.ProfileContent" android:gravity="center_vertical" android:text="Change password" android:textStyle="bold" />
                    <ImageView style="@style/Widget.Wallet.ChevronImage" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
