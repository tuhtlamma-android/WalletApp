<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="756dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:background="@color/wallet_auth_background">

                <ImageView
                    android:layout_width="89dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/img_text_screen" />

                <ImageView
                    android:layout_width="188dp"
                    android:layout_height="191dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="70dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wallet_phone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/TextAppearance.Wallet.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/enter_mobile_number"
                    android:textSize="21sp" />

                <TextView
                    style="@style/TextAppearance.Wallet.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/mobile_number"
                    android:textColor="@color/wallet_black" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_wallet_outline"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="29dp"
                        android:layout_height="21dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_flag_jordan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="+962"
                        android:textColor="@color/wallet_black"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/wallet_black" />

                    <EditText
                        android:id="@+id/mobileInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/phone_hint"
                        android:importantForAutofill="yes"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:textColor="@color/wallet_black"
                        android:textColorHint="@color/wallet_input_hint"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/createAccountButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:gravity="end|center_vertical"
                    android:text="@string/create_account_prompt"
                    android:textColor="@color/wallet_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continueButton"
                    style="@style/Widget.Wallet.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="@string/continue_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/wallet_alice_blue" />
                    <TextView style="@style/TextAppearance.Wallet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:text="@string/or_continue_using" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/wallet_alice_blue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <ImageView style="@style/Widget.Wallet.SocialButton" android:src="@drawable/ic_facebook_logo" />
                    <ImageView style="@style/Widget.Wallet.SocialButton" android:layout_marginHorizontal="16dp" android:src="@drawable/ic_google_logo" />
                    <ImageView style="@style/Widget.Wallet.SocialButton" android:src="@drawable/ic_apple_logo" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
