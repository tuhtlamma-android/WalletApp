<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wallet_auth_background">


        <androidx.appcompat.widget.Toolbar
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@color/wallet_auth_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="89dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/img_text_screen" />

        </androidx.appcompat.widget.Toolbar>

        <FrameLayout
            android:id="@+id/illustrationContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/wallet_auth_background"
            app:layout_constraintBottom_toTopOf="@id/contentLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

            <ImageView
                android:id="@+id/phoneIllustration"
                android:layout_width="188dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wallet_phone" />

        </FrameLayout>


        <!-- ========================= -->
        <!-- BOTTOM CONTENT -->
        <!-- Luôn bám đáy -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- TITLE -->

            <TextView
                style="@style/TextAppearance.Wallet.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/enter_mobile_number"
                android:textSize="21sp" />


            <!-- MOBILE NUMBER LABEL -->

            <TextView
                style="@style/TextAppearance.Wallet.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/mobile_number"
                android:textColor="@color/wallet_black" />


            <!-- PHONE INPUT -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_wallet_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <com.hbb20.CountryCodePicker
                    android:id="@+id/countryCodePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/select_country_code"
                    android:gravity="center_vertical"
                    app:ccp_arrowColor="@color/wallet_black"
                    app:ccp_arrowSize="16dp"
                    app:ccp_autoDetectCountry="false"
                    app:ccp_autoDetectLanguage="true"
                    app:ccp_autoFormatNumber="true"
                    app:ccp_contentColor="@color/wallet_black"
                    app:ccp_countryAutoDetectionPref="SIM_NETWORK_LOCALE"
                    app:ccp_defaultNameCode="JO"
                    app:ccp_hintExampleNumber="true"
                    app:ccp_padding="0dp"
                    app:ccp_showArrow="true"
                    app:ccp_showFlag="true"
                    app:ccp_showNameCode="false"
                    app:ccp_showPhoneCode="true"
                    app:ccp_textSize="14sp"
                    app:ccpDialog_allowSearch="true"
                    app:ccpDialog_showFlag="true"
                    app:ccpDialog_showNameCode="true"
                    app:ccpDialog_showPhoneCode="true" />

                <EditText
                    android:id="@+id/mobileInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/phone_hint"
                    android:importantForAutofill="yes"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/wallet_black"
                    android:textColorHint="@color/wallet_input_hint"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- CREATE ACCOUNT -->

            <TextView
                android:id="@+id/createAccountButton"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="end"
                android:text="@string/create_account_prompt"
                android:textColor="@color/wallet_blue"
                android:textSize="12sp"
                android:textStyle="bold" />


            <!-- CONTINUE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.Wallet.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/continue_label" />


            <!-- OR CONTINUE USING -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/wallet_alice_blue" />

                <TextView
                    style="@style/TextAppearance.Wallet.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:text="@string/or_continue_using" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/wallet_alice_blue" />

            </LinearLayout>


            <!-- SOCIAL BUTTONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.Wallet.SocialButton"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_facebook_logo" />

                <ImageView
                    style="@style/Widget.Wallet.SocialButton"
                    android:layout_marginHorizontal="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_google_logo" />

                <ImageView
                    style="@style/Widget.Wallet.SocialButton"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_apple_logo" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
