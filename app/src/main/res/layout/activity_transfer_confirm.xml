<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/backButton" style="@style/Widget.Wallet.BackButton" />
        <TextView style="@style/TextAppearance.Wallet.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="@string/transfer_to" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="24dp" android:gravity="center" android:orientation="horizontal">
            <ImageView android:id="@+id/recipientAvatar" android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="@null" android:src="@drawable/img_avatar_ali" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:id="@+id/recipientNameText" style="@style/TextAppearance.Wallet.DialogTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" /><TextView android:id="@+id/recipientSubtitle" style="@style/TextAppearance.Wallet.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
        </LinearLayout>
        <TextView style="@style/TextAppearance.Wallet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:gravity="center" android:text="Enter Amount" />
        <TextView android:id="@+id/amountText" android:layout_width="match_parent" android:layout_height="72dp" android:fontFamily="@font/sora_family" android:gravity="center" android:textColor="@color/wallet_black" android:textSize="36sp" />
        <View android:layout_width="198dp" android:layout_height="1dp" android:layout_gravity="center_horizontal" android:background="@color/wallet_black_coral" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/securePaymentButton" style="@style/Widget.Wallet.PrimaryButton" android:layout_width="match_parent" android:layout_marginBottom="16dp" android:backgroundTint="@color/wallet_mango" android:text="Secure payment" android:textColor="@color/wallet_purple_dark" app:icon="@drawable/ic_wallet_secure" app:iconGravity="textStart" app:iconSize="18dp" app:iconTint="@null" />
    </LinearLayout>
</layout>
