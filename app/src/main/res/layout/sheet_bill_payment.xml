    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_wallet_circle_purple" android:gravity="center" android:text="ϟ" android:textColor="@color/wallet_purple" android:textSize="26sp" />
