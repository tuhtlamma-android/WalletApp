<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <TextView android:id="@+id/backButton" style="@style/Widget.Wallet.BackButton" />
        <TextView style="@style/TextAppearance.Wallet.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/transfer_to" />
        <LinearLayout android:id="@+id/newContactButton" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="28dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:src="@drawable/ic_add_contact" />
            <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="New contact" android:textColor="@color/wallet_black" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/wallet_alice_blue" />
            <TextView style="@style/TextAppearance.Wallet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="or" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/wallet_alice_blue" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/bg_wallet_outline" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_wallet_search" />
            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search contact"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:padding="0dp"
                android:textColorHint="@color/wallet_input_hint"
                android:textSize="13sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView
                android:id="@+id/emptyState"
                style="@style/TextAppearance.Wallet.Body"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/no_recipients_yet"
                android:textColor="@color/wallet_slate" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/contactList" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </FrameLayout>
    </LinearLayout>
</layout>
