<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <TextView android:id="@+id/backButton" style="@style/Widget.Wallet.BackButton" />
        <TextView style="@style/TextAppearance.Wallet.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Pay to" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="28dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:src="@drawable/ic_add_contact" />
            <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="New biller" android:textColor="@color/wallet_black" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/wallet_alice_blue" />
            <TextView style="@style/TextAppearance.Wallet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="or" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/wallet_alice_blue" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/bg_wallet_outline" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_wallet_search" />
            <EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@null" android:fontFamily="@font/sora_family" android:hint="Search biller" android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" android:padding="0dp" android:textColor="@color/wallet_black" android:textColorHint="@color/wallet_input_hint" android:textSize="14sp" />
        </LinearLayout>
        <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="bottom" android:paddingBottom="10dp" android:text="Saved billers" android:textColor="@color/wallet_black_coral" />
        <LinearLayout android:id="@+id/billerButton" style="@style/Widget.Wallet.ListRow">
            <ImageView style="@style/Widget.Wallet.MenuIcon" android:src="@drawable/ic_biller_electricity" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TextAppearance.Wallet.ItemTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Electricity" />
                <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Due: $132.32" android:textColor="@color/wallet_black_coral" />
            </LinearLayout>
            <ImageView style="@style/Widget.Wallet.ChevronImage" />
        </LinearLayout>
        <View style="@style/Widget.Wallet.Divider" />
        <LinearLayout android:id="@+id/waterBillerButton" style="@style/Widget.Wallet.ListRow">
            <ImageView style="@style/Widget.Wallet.MenuIcon" android:src="@drawable/ic_biller_water" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TextAppearance.Wallet.ItemTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water" />
                <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Due: $32.21" android:textColor="@color/wallet_black_coral" />
            </LinearLayout>
            <ImageView style="@style/Widget.Wallet.ChevronImage" />
        </LinearLayout>
        <View style="@style/Widget.Wallet.Divider" />
        <LinearLayout android:id="@+id/phoneBillerButton" style="@style/Widget.Wallet.ListRow">
            <ImageView style="@style/Widget.Wallet.MenuIcon" android:src="@drawable/ic_biller_phone" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TextAppearance.Wallet.ItemTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phone" />
                <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All paid" android:textColor="@color/wallet_black_coral" />
            </LinearLayout>
            <ImageView style="@style/Widget.Wallet.ChevronImage" />
        </LinearLayout>
    </LinearLayout>
</layout>
