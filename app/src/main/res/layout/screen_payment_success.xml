<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView android:layout_width="126dp" android:layout_height="126dp" android:layout_gravity="center_horizontal" android:layout_marginTop="40dp" android:background="@drawable/bg_wallet_success_circle" android:contentDescription="Payment successful" android:padding="34dp" android:src="@drawable/ic_wallet_check" />
    <TextView style="@style/TextAppearance.Wallet.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Payment done!" android:textSize="16sp" />
    <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Bill payment has been done\nsuccessfully" />

    <TextView style="@style/TextAppearance.Wallet.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="72dp" android:text="Payment details" />
    <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="16dp" android:background="@drawable/bg_wallet_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Biller\nElectricity company inc." android:textStyle="bold" />
    <TextView style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="16dp" android:background="@drawable/bg_wallet_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Amount\n$132.32" android:textStyle="bold" />
    <TextView android:id="@+id/copyButton" style="@style/TextAppearance.Wallet.Body" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="16dp" android:background="@drawable/bg_wallet_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Transaction no.\n23010412432431                                             ▣" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center" android:text="@string/report_problem" android:textColor="@color/wallet_error" android:textSize="14sp" android:textStyle="bold" />
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <com.google.android.material.button.MaterialButton android:id="@+id/backToWalletButton" style="@style/Widget.Wallet.PrimaryButton" android:layout_width="match_parent" android:text="@string/back_to_wallet" />
</LinearLayout>
