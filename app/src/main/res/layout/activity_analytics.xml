<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wallet_surface_alt"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/white">

            <TextView
                android:id="@+id/backButton"
                style="@style/Widget.Wallet.BackButton"
                android:layout_gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="0dp" />

            <TextView
                style="@style/TextAppearance.Wallet.DialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/analytics" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_semibold"
                    android:text="@string/analytics_heading"
                    android:textColor="@color/wallet_black"
                    android:textSize="22sp" />

                <TextView
                    style="@style/TextAppearance.Wallet.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/analytics_description" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_analytics_period_container"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/period7DaysButton"
                        style="@style/Widget.Wallet.AnalyticsPeriod"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/analytics_7_days" />

                    <TextView
                        android:id="@+id/period30DaysButton"
                        style="@style/Widget.Wallet.AnalyticsPeriod"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/analytics_30_days" />

                    <TextView
                        android:id="@+id/periodAllButton"
                        style="@style/Widget.Wallet.AnalyticsPeriod"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/analytics_all" />
                </LinearLayout>

                <TextView
                    android:id="@+id/emptyState"
                    style="@style/TextAppearance.Wallet.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_analytics_card"
                    android:gravity="center"
                    android:padding="28dp"
                    android:text="@string/analytics_empty_state"
                    android:textAlignment="center" />

                <LinearLayout
                    android:id="@+id/analyticsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_analytics_hero"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sora_regular"
                            android:text="@string/analytics_total_spent"
                            android:textColor="@color/wallet_balance_label"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/totalSpentText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/sora_semibold"
                            android:text="@string/zero_balance"
                            android:textColor="@color/white"
                            android:textSize="31sp" />

                        <TextView
                            android:id="@+id/periodSummaryText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/sora_regular"
                            android:text="@string/analytics_summary_7_days"
                            android:textColor="@color/wallet_balance_label"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="104dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_analytics_card"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/transactionCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sora_semibold"
                                android:text="@string/analytics_zero_count"
                                android:textColor="@color/wallet_purple_dark"
                                android:textSize="23sp" />

                            <TextView
                                style="@style/TextAppearance.Wallet.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/analytics_transactions" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="104dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_analytics_card"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/averageTransactionText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/sora_semibold"
                                android:maxLines="1"
                                android:text="@string/zero_balance"
                                android:textColor="@color/wallet_purple_dark"
                                android:textSize="20sp" />

                            <TextView
                                style="@style/TextAppearance.Wallet.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/analytics_average" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_analytics_card"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/TextAppearance.Wallet.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_spending_pulse" />

                        <TextView
                            android:id="@+id/trendPeriodText"
                            style="@style/TextAppearance.Wallet.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/analytics_trend_daily" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="168dp"
                            android:layout_marginTop="8dp"
                            android:fillViewport="true"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <com.lmt.global.base.presenter.analytics.SpendingBarChartView
                                android:id="@+id/spendingChart"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_analytics_card"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/TextAppearance.Wallet.Section"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/analytics_where_it_went" />

                            <TextView
                                android:id="@+id/categoryCountText"
                                style="@style/TextAppearance.Wallet.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/analytics_zero_categories" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/categoryList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:overScrollMode="never" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
