<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PhoneTracker_Kotlin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/wallet_purple</item>
        <item name="colorPrimaryContainer">@color/wallet_purple_soft</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:fontFamily">@font/sora_family</item>
        <item name="fontFamily">@font/sora_family</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.PhoneTracker_Kotlin" parent="Base.Theme.PhoneTracker_Kotlin" />

    <style name="Theme.PhoneTracker_Kotlin.Splash" parent="Base.Theme.PhoneTracker_Kotlin">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/wallet_purple</item>
        <item name="android:navigationBarColor">@color/wallet_purple</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/wallet_purple</item>
    </style>

    <style name="TextAppearance.Wallet.Display" parent="">
        <item name="android:fontFamily">@font/sora_family</item>
        <item name="android:textColor">@color/wallet_black</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Wallet.Title" parent="">
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textColor">@color/wallet_black</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="TextAppearance.Wallet.Section" parent="">
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textColor">@color/wallet_black</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Wallet.Body" parent="">
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:textColor">@color/wallet_black_coral</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Wallet.DialogTitle" parent="TextAppearance.Wallet.Title">
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Wallet.ItemTitle" parent="TextAppearance.Wallet.Section">
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Wallet.Subtitle" parent="TextAppearance.Wallet.Body">
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:textColor">@color/wallet_slate</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Wallet.Link" parent="TextAppearance.Wallet.Body">
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textColor">@color/wallet_blue</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Wallet.Caption" parent="">
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:textColor">@color/wallet_slate</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallet.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/wallet_button_height</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">#5732BF</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="Widget.Wallet.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_wallet_outline</item>
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/wallet_black</item>
        <item name="android:textColorHint">@color/wallet_input_hint</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Wallet.BackButton.Base" parent="">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:drawableStart">@drawable/ic_wallet_back</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:text">@string/back_arrow</item>
        <item name="android:textColor">@color/wallet_blue</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style
        name="Widget.Wallet.BackButton"
        parent="Widget.Wallet.BackButton.Base" />

    <style name="Widget.Wallet.SocialButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_wallet_outline</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.Wallet.Key" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/wallet_black</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="Widget.Wallet.KeyImage" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:padding">22dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.Wallet.NavigationItem" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="Widget.Wallet.NavigationIndicator" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:background">@drawable/sel_nav_indicator</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="Widget.Wallet.NavigationIcon" parent="">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.Wallet.NavigationLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:fontFamily">@font/sora_family</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/wallet_nav_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallet.BalanceAction" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="Widget.Wallet.BalanceActionIcon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.Wallet.BalanceActionLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallet.BalanceDivider" parent="">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:background">#7056C0</item>
    </style>

    <style name="Widget.Wallet.AvatarColumn" parent="">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Wallet.AvatarImage" parent="">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.Wallet.AvatarName" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/wallet_black</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallet.DetailBox" parent="TextAppearance.Wallet.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_wallet_outline</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:fontFamily">@font/sora_family</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Wallet.DetailBoxRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_wallet_outline</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.Wallet.ProfileRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">61dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Wallet.ProfileContent" parent="TextAppearance.Wallet.Body">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Widget.Wallet.ProfileLabel" parent="TextAppearance.Wallet.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:textColor">@color/wallet_slate</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallet.ProfileValue" parent="TextAppearance.Wallet.Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallet.ProfileEdit" parent="TextAppearance.Wallet.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/wallet_blue</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallet.MenuRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">57dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.Wallet.MenuIcon" parent="">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.Wallet.MenuLabel" parent="TextAppearance.Wallet.Section">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallet.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/wallet_alice_blue</item>
    </style>

    <style name="Widget.Wallet.ListRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.Wallet.ListContent" parent="TextAppearance.Wallet.Section">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallet.ChevronImage" parent="">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_wallet_chevron</item>
    </style>
</resources>
